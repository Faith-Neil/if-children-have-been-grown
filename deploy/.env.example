# 复制为 deploy/.env 后填写；.env 不提交。三台服务器分别为：MySQL 服务器、RAGFlow 服务器、应用服务器。
# MySQL 服务器
MYSQL_HOST=192.0.2.10
MYSQL_PORT=3306
MYSQL_DATABASE=icg
MYSQL_USER=icg
MYSQL_PASSWORD=replace-with-the-app-password

# 应用服务器
ICG_SECRET_KEY=replace-with-a-fernet-key
ICG_ADMIN_INITIAL_PASSWORD=replace-with-the-first-admin-password
ICG_SECTION_CONCURRENCY=2

# RAGFlow 服务器（内网地址；后端 httpx 已固定 trust_env=False，不读系统代理）
ICG_RAGFLOW_BASE_URL=http://192.0.2.20:9380
ICG_RAGFLOW_API_KEY=replace-with-ragflow-api-key
ICG_RAGFLOW_TIMEOUT_SECONDS=30
